{
  "opencollection": "1.0.0",
  "info": {
    "name": "Juniper Networks Juniper Apstra Allowlists and Blocklists RF Templates API",
    "version": "4.2.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "AuthToken",
      "value": "{{AuthToken}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "RF Templates",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Juniper Networks List RF templates",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{apstra_server}/api/sites/:site_id/rftemplates",
            "params": [
              {
                "name": "site_id",
                "value": "",
                "type": "path",
                "description": "Site unique identifier"
              }
            ]
          },
          "docs": "Returns RF templates available at the site."
        }
      ]
    }
  ],
  "bundled": true
}