{
  "opencollection": "1.0.0",
  "info": {
    "name": "Juniper Networks Juniper Contrail Networking API",
    "version": "5.1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
