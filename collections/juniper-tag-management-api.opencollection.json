{
  "opencollection": "1.0.0",
  "info": {
    "name": "Juniper Networks Juniper Apstra Allowlists and Blocklists Tag Management API",
    "version": "4.2.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "AuthToken",
      "value": "{{AuthToken}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Tag Management",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Juniper Networks List tags",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{apstra_server}/api/tag-management/tags"
          },
          "docs": "Returns all tags used for device grouping."
        },
        {
          "info": {
            "name": "Juniper Networks Create a tag",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{apstra_server}/api/tag-management/tags",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a new tag for device grouping."
        }
      ]
    }
  ],
  "bundled": true
}