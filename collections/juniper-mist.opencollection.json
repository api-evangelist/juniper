            "name": "Juniper Networks List API tokens",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.mist.com/api/v1/self/apitokens"
          },
          "docs": "Returns a list of API tokens for the authenticated user."
