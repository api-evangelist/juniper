        {
          "info": {
            "name": "Juniper Networks Create API token",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.mist.com/api/v1/self/apitokens",
            "body": {
              "type": "json",
              "data": "{}"
