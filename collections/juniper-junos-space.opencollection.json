{
  "opencollection": "1.0.0",
  "info": {
    "name": "Juniper Networks Junos Space Network Management Platform API",
    "version": "23.1.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Devices",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Juniper Networks List managed devices",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{space_server}/api/space/device-management/devices",
            "params": [
              {
                "name": "filter",
                "value": "",
                "type": "query",
                "description": "Filter expression for devices"
              },
              {
                "name": "paging.start",
                "value": "",
                "type": "query",
                "description": "Starting index for pagination"
              },
              {
                "name": "paging.limit",
                "value": "",
                "type": "query",
                "description": "Number of results per page"
              }
            ]
          },
          "docs": "Returns all devices managed by Junos Space."
        },
        {
          "info": {
            "name": "Juniper Networks Discover a device",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{space_server}/api/space/device-management/devices",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Initiates device discovery to add a new device to Junos Space management."
        },
        {
          "info": {
            "name": "Juniper Networks Get device details",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{space_server}/api/space/device-management/devices/:device_id",
            "params": [
              {
                "name": "device_id",
                "value": "",
                "type": "path",
                "description": "Device unique identifier"
              }
            ]
          },
          "docs": "Returns detailed information for a specific managed device."
        },
        {
          "info": {
            "name": "Juniper Networks Delete managed device",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://{space_server}/api/space/device-management/devices/:device_id",
            "params": [
              {
                "name": "device_id",
                "value": "",
                "type": "path",
                "description": "Device unique identifier"
              }
            ]
          },
          "docs": "Removes a device from Junos Space management."
        }
      ]
    },
    {
      "info": {
        "name": "Configuration",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Juniper Networks Get device configuration",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{space_server}/api/space/device-management/devices/:device_id/configurations/raw",
            "params": [
              {
                "name": "device_id",
                "value": "",
                "type": "path",
                "description": "Device unique identifier"
              }
            ]
          },
          "docs": "Returns the current running configuration of a managed device."
        },
        {
          "info": {
            "name": "Juniper Networks List configuration files",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{space_server}/api/space/config-file-management/config-files",
            "params": [
              {
                "name": "paging.start",
                "value": "",
                "type": "query",
                "description": "Starting index for pagination"
              },
              {
                "name": "paging.limit",
                "value": "",
                "type": "query",
                "description": "Number of results per page"
              }
            ]
          },
          "docs": "Returns all stored configuration file versions."
        },
        {
          "info": {
            "name": "Juniper Networks Apply configlet to devices",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{space_server}/api/space/config-file-management/apply-configlet",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Applies a configuration template (configlet) to one or more devices."
        }
      ]
    },
    {
      "info": {
        "name": "Software Management",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Juniper Networks List software packages",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{space_server}/api/space/software-management/packages"
          },
          "docs": "Returns all software packages (images) available in Junos Space."
        },
        {
          "info": {
            "name": "Juniper Networks Deploy software to devices",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{space_server}/api/space/software-management/packages/deploy",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Deploys a software package to one or more managed devices."
        }
      ]
    },
    {
      "info": {
        "name": "Scripts",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Juniper Networks List scripts",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{space_server}/api/space/script-management/scripts"
          },
          "docs": "Returns all script bundles available in Junos Space."
        },
        {
          "info": {
            "name": "Juniper Networks Execute script on devices",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{space_server}/api/space/script-management/scripts/:script_id/execute",
            "params": [
              {
                "name": "script_id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Executes a script on one or more managed devices."
        }
      ]
    },
    {
      "info": {
        "name": "Users",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Juniper Networks List users",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{space_server}/api/space/user-management/users"
          },
          "docs": "Returns all users configured in Junos Space."
        },
        {
          "info": {
            "name": "Juniper Networks List roles",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{space_server}/api/space/user-management/roles"
          },
          "docs": "Returns all roles available in Junos Space."
        }
      ]
    },
    {
      "info": {
        "name": "Default",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Juniper Networks List tags",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{space_server}/api/space/tag-management/tags"
          },
          "docs": "Returns all tags used for device grouping."
        },
        {
          "info": {
            "name": "Juniper Networks Create a tag",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{space_server}/api/space/tag-management/tags",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a new tag for device grouping."
        }
      ]
    },
    {
      "info": {
        "name": "Audit Logs",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Juniper Networks List audit events",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{space_server}/api/space/audit-log/events",
            "params": [
              {
                "name": "startTime",
                "value": "",
                "type": "query"
              },
              {
                "name": "endTime",
                "value": "",
                "type": "query"
              },
              {
                "name": "paging.start",
                "value": "",
                "type": "query",
                "description": "Starting index for pagination"
              },
              {
                "name": "paging.limit",
                "value": "",
                "type": "query",
                "description": "Number of results per page"
              }
            ]
          },
          "docs": "Returns audit log events for Junos Space operations."
        }
      ]
    },
    {
      "info": {
        "name": "Jobs",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Juniper Networks List jobs",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{space_server}/api/space/job-management/jobs",
            "params": [
              {
                "name": "state",
                "value": "",
                "type": "query",
                "description": "Filter by job state"
              },
              {
                "name": "paging.start",
                "value": "",
                "type": "query",
                "description": "Starting index for pagination"
              },
              {
                "name": "paging.limit",
                "value": "",
                "type": "query",
                "description": "Number of results per page"
              }
            ]
          },
          "docs": "Returns the list of asynchronous jobs."
        },
        {
          "info": {
            "name": "Juniper Networks Get job details",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{space_server}/api/space/job-management/jobs/:job_id",
            "params": [
              {
                "name": "job_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Returns details for a specific asynchronous job."
        }
      ]
    }
  ],
  "bundled": true
}