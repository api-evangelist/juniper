{
  "opencollection": "1.0.0",
  "info": {
    "name": "Juniper Networks Juniper Apstra Allowlists and Blocklists WAN Edges API",
    "version": "4.2.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "AuthToken",
      "value": "{{AuthToken}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "WAN Edges",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Juniper Networks List WAN edge devices",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{apstra_server}/api/orgs/:org_id/wanedges",
            "params": [
              {
                "name": "org_id",
                "value": "",
                "type": "path",
                "description": "Organization unique identifier"
              }
            ]
          },
          "docs": "Returns SD-WAN edge devices for the organization."
        }
      ]
    }
  ],
  "bundled": true
}