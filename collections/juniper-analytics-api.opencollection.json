{
  "opencollection": "1.0.0",
  "info": {
    "name": "Juniper Networks Juniper Apstra Allowlists and Blocklists Analytics API",
    "version": "4.2.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "AuthToken",
      "value": "{{AuthToken}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Analytics",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Juniper Networks List virtual network analytics",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{apstra_server}/api/analytics/uves/virtual-networks"
          },
          "docs": "Returns UVE (User Visible Entity) analytics for all virtual networks."
        },
        {
          "info": {
            "name": "Juniper Networks Get virtual network analytics",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{apstra_server}/api/analytics/uves/virtual-network/:vn_fqname",
            "params": [
              {
                "name": "vn_fqname",
                "value": "",
                "type": "path",
                "description": "Fully qualified name of the virtual network"
              }
            ]
          },
          "docs": "Returns detailed analytics for a specific virtual network."
        },
        {
          "info": {
            "name": "Juniper Networks List vRouter analytics",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{apstra_server}/api/analytics/uves/vrouters"
          },
          "docs": "Returns analytics for all vRouters (compute node agents)."
        }
      ]
    }
  ],
  "bundled": true
}