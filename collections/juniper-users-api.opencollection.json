{
  "opencollection": "1.0.0",
  "info": {
    "name": "Juniper Networks Juniper Apstra Allowlists and Blocklists Users API",
    "version": "4.2.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "AuthToken",
      "value": "{{AuthToken}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Users",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Juniper Networks List users",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{apstra_server}/api/user-management/users"
          },
          "docs": "Returns all users configured in Junos Space."
        },
        {
          "info": {
            "name": "Juniper Networks List roles",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{apstra_server}/api/user-management/roles"
          },
          "docs": "Returns all roles available in Junos Space."
        }
      ]
    }
  ],
  "bundled": true
}