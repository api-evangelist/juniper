{
  "opencollection": "1.0.0",
  "info": {
    "name": "Juniper Networks Juniper Apstra Allowlists and Blocklists Floating IPs API",
    "version": "4.2.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "AuthToken",
      "value": "{{AuthToken}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Floating IPs",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Juniper Networks List floating IP pools",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{apstra_server}/api/floating-ip-pools"
          },
          "docs": "Returns all floating IP pools."
        },
        {
          "info": {
            "name": "Juniper Networks List floating IPs",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{apstra_server}/api/floating-ips"
          },
          "docs": "Returns all floating IPs."
        }
      ]
    }
  ],
  "bundled": true
}