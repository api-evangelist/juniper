{
  "opencollection": "1.0.0",
  "info": {
    "name": "Juniper Networks Juniper Apstra Allowlists and Blocklists Jobs API",
    "version": "4.2.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "AuthToken",
      "value": "{{AuthToken}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Jobs",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Juniper Networks List jobs",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{apstra_server}/api/job-management/jobs",
            "params": [
              {
                "name": "state",
                "value": "",
                "type": "query",
                "description": "Filter by job state"
              },
              {
                "name": "paging.start",
                "value": "",
                "type": "query",
                "description": "Starting index for pagination"
              },
              {
                "name": "paging.limit",
                "value": "",
                "type": "query",
                "description": "Number of results per page"
              }
            ]
          },
          "docs": "Returns the list of asynchronous jobs."
        },
        {
          "info": {
            "name": "Juniper Networks Get job details",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{apstra_server}/api/job-management/jobs/:job_id",
            "params": [
              {
                "name": "job_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Returns details for a specific asynchronous job."
        }
      ]
    }
  ],
  "bundled": true
}