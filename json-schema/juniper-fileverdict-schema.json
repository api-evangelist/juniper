{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/FileVerdict",
  "title": "FileVerdict",
  "type": "object",
  "properties": {
    "sha256": {
      "type": "string"
    },
    "md5": {
      "type": "string"
    },
    "sha1": {
      "type": "string"
    },
    "verdict": {
      "type": "string",
      "enum": [
        "clean",
        "malicious",
        "suspicious",
        "unknown"
      ]
    },
    "malware_family": {
      "type": "string"
    },
    "threat_score": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10
    },
    "first_seen": {
      "type": "string",
      "format": "date-time"
    },
    "last_seen": {
      "type": "string",
      "format": "date-time"
    }
  }
}