{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/ThreatFeed",
  "title": "ThreatFeed",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "enabled": {
      "type": "boolean"
    },
    "last_updated": {
      "type": "string",
      "format": "date-time"
    },
    "entry_count": {
      "type": "integer"
    },
    "feed_type": {
      "type": "string",
      "enum": [
        "ip",
        "domain",
        "url",
        "hash"
      ]
    }
  }
}