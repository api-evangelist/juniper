{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/BgpPeer",
  "title": "BgpPeer",
  "type": "object",
  "properties": {
    "peer-address": {
      "type": "string"
    },
    "peer-as": {
      "type": "integer"
    },
    "local-address": {
      "type": "string"
    },
    "local-as": {
      "type": "integer"
    },
    "peer-state": {
      "type": "string",
      "enum": [
        "Established",
        "Active",
        "Connect",
        "OpenSent",
        "OpenConfirm",
        "Idle"
      ]
    },
    "peer-type": {
      "type": "string",
      "enum": [
        "Internal",
        "External"
      ]
    },
    "route-received": {
      "type": "integer"
    },
    "route-accepted": {
      "type": "integer"
    },
    "route-advertised": {
      "type": "integer"
    },
    "elapsed-time": {
      "type": "string"
    }
  }
}