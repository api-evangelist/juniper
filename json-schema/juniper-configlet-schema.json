{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/Configlet",
  "title": "Configlet",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "label": {
      "type": "string"
    },
    "generators": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "config_style": {
            "type": "string",
            "enum": [
              "junos",
              "eos",
              "nxos",
              "sonic"
            ]
          },
          "section": {
            "type": "string",
            "enum": [
              "system",
              "interface",
              "set_based_system",
              "set_based_interface"
            ]
          },
          "template_text": {
            "type": "string"
          }
        }
      }
    }
  }
}