{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/IpReputation",
  "title": "IpReputation",
  "type": "object",
  "properties": {
    "ip": {
      "type": "string"
    },
    "threat_score": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10,
      "description": "Threat score from 0 (clean) to 10 (malicious)"
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "country": {
      "type": "string"
    },
    "asn": {
      "type": "integer"
    },
    "last_seen": {
      "type": "string",
      "format": "date-time"
    },
    "feeds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}