{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/Blueprint",
  "title": "Blueprint",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "label": {
      "type": "string"
    },
    "design": {
      "type": "string",
      "enum": [
        "two_stage_l3clos",
        "freeform"
      ]
    },
    "status": {
      "type": "string",
      "description": "Current status of the blueprint"
    },
    "build_errors_count": {
      "type": "integer"
    },
    "build_warnings_count": {
      "type": "integer"
    },
    "anomaly_count": {
      "type": "integer"
    },
    "version": {
      "type": "integer"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_modified_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}