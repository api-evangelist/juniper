{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/Privilege",
  "title": "Privilege",
  "type": "object",
  "properties": {
    "scope": {
      "type": "string",
      "enum": [
        "org",
        "site",
        "sitegroup"
      ]
    },
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "write",
        "read",
        "helpdesk"
      ]
    },
    "org_id": {
      "type": "string",
      "format": "uuid"
    },
    "site_id": {
      "type": "string",
      "format": "uuid"
    },
    "sitegroup_id": {
      "type": "string",
      "format": "uuid"
    }
  }
}