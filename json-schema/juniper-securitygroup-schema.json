{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/SecurityGroup",
  "title": "SecurityGroup",
  "type": "object",
  "properties": {
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "fq_name": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "display_name": {
      "type": "string"
    },
    "security_group_entries": {
      "type": "object",
      "properties": {
        "policy_rule": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "direction": {
                "type": "string"
              },
              "protocol": {
                "type": "string"
              },
              "ethertype": {
                "type": "string",
                "enum": [
                  "IPv4",
                  "IPv6"
                ]
              },
              "src_addresses": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              },
              "dst_addresses": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              },
              "src_ports": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              },
              "dst_ports": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    }
  }
}