{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/VirtualNetwork",
  "title": "VirtualNetwork",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "label": {
      "type": "string"
    },
    "vn_type": {
      "type": "string",
      "enum": [
        "vxlan",
        "vlan"
      ]
    },
    "vn_id": {
      "type": "string"
    },
    "security_zone_id": {
      "type": "string",
      "format": "uuid"
    },
    "ipv4_subnet": {
      "type": "string"
    },
    "ipv4_gateway": {
      "type": "string"
    },
    "ipv6_subnet": {
      "type": "string"
    },
    "vlan_id": {
      "type": "integer"
    },
    "bound_to": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "system_id": {
            "type": "string"
          },
          "vlan_id": {
            "type": "integer"
          },
          "access_switches": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      }
    }
  }
}