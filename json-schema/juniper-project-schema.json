{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/Project",
  "title": "Project",
  "type": "object",
  "properties": {
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "fq_name": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "display_name": {
      "type": "string"
    },
    "id_perms": {
      "$ref": "#/components/schemas/IdPerms"
    },
    "quota": {
      "type": "object",
      "properties": {
        "virtual_network": {
          "type": "integer"
        },
        "subnet": {
          "type": "integer"
        },
        "security_group": {
          "type": "integer"
        },
        "floating_ip": {
          "type": "integer"
        }
      }
    }
  }
}