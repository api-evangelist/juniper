{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/IpPool",
  "title": "IpPool",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "label": {
      "type": "string"
    },
    "subnets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "network": {
            "type": "string",
            "description": "CIDR notation"
          },
          "status": {
            "type": "string"
          }
        }
      }
    },
    "status": {
      "type": "string"
    },
    "used": {
      "type": "integer"
    },
    "total": {
      "type": "integer"
    }
  }
}