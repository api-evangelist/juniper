{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/Script",
  "title": "Script",
  "type": "object",
  "properties": {
    "scriptId": {
      "type": "integer"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "scriptType": {
      "type": "string",
      "enum": [
        "op",
        "event",
        "commit",
        "snmp"
      ]
    },
    "language": {
      "type": "string",
      "enum": [
        "slax",
        "xslt",
        "python"
      ]
    }
  }
}