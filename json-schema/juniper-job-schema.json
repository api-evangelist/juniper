{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/Job",
  "title": "Job",
  "type": "object",
  "properties": {
    "jobId": {
      "type": "integer"
    },
    "name": {
      "type": "string"
    },
    "state": {
      "type": "string",
      "enum": [
        "INPROGRESS",
        "SUCCESS",
        "FAILURE",
        "CANCELLED"
      ]
    },
    "percentComplete": {
      "type": "number"
    },
    "createdTime": {
      "type": "string",
      "format": "date-time"
    },
    "completedTime": {
      "type": "string",
      "format": "date-time"
    },
    "summary": {
      "type": "string"
    }
  }
}