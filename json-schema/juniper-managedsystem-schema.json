{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/ManagedSystem",
  "title": "ManagedSystem",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "label": {
      "type": "string"
    },
    "hostname": {
      "type": "string"
    },
    "system_id": {
      "type": "string"
    },
    "device_key": {
      "type": "string"
    },
    "status": {
      "type": "object",
      "properties": {
        "agent_alive": {
          "type": "boolean"
        },
        "config_deviation": {
          "type": "boolean"
        },
        "hostname": {
          "type": "string"
        }
      }
    },
    "facts": {
      "type": "object",
      "properties": {
        "os_family": {
          "type": "string"
        },
        "os_version": {
          "type": "string"
        },
        "vendor": {
          "type": "string"
        },
        "hw_model": {
          "type": "string"
        },
        "serial_number": {
          "type": "string"
        },
        "mgmt_ipaddr": {
          "type": "string"
        }
      }
    }
  }
}