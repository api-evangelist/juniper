{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/EnrolledDevice",
  "title": "EnrolledDevice",
  "type": "object",
  "properties": {
    "device_id": {
      "type": "string"
    },
    "hostname": {
      "type": "string"
    },
    "serial_number": {
      "type": "string"
    },
    "model": {
      "type": "string",
      "description": "Device model (e.g., SRX340, SRX4600)"
    },
    "os_version": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "connected",
        "disconnected",
        "pending"
      ]
    },
    "last_seen": {
      "type": "string",
      "format": "date-time"
    },
    "enrolled_at": {
      "type": "string",
      "format": "date-time"
    },
    "license_type": {
      "type": "string"
    }
  }
}