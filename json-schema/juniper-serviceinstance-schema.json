{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/ServiceInstance",
  "title": "ServiceInstance",
  "type": "object",
  "properties": {
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "fq_name": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "display_name": {
      "type": "string"
    },
    "service_instance_properties": {
      "type": "object",
      "properties": {
        "interface_list": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "virtual_network": {
                "type": "string"
              }
            }
          }
        },
        "scale_out": {
          "type": "object",
          "properties": {
            "max_instances": {
              "type": "integer"
            }
          }
        },
        "ha_mode": {
          "type": "string",
          "enum": [
            "active-active",
            "active-standby"
          ]
        }
      }
    },
    "service_template_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "to": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}