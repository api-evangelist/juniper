{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/NetworkIpam",
  "title": "NetworkIpam",
  "type": "object",
  "properties": {
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "fq_name": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "display_name": {
      "type": "string"
    },
    "ipam_method": {
      "type": "string",
      "enum": [
        "dhcp",
        "fixed"
      ]
    },
    "ipam_dns_method": {
      "type": "string",
      "enum": [
        "default-dns-server",
        "virtual-dns-server",
        "tenant-dns-server",
        "none"
      ]
    }
  }
}