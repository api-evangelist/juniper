{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/SiteInsights",
  "title": "SiteInsights",
  "type": "object",
  "properties": {
    "site_id": {
      "type": "string",
      "format": "uuid"
    },
    "metrics": {
      "type": "object",
      "properties": {
        "time_to_connect": {
          "type": "object",
          "properties": {
            "total": {
              "type": "number"
            },
            "user_minutes": {
              "type": "number"
            }
          }
        },
        "throughput": {
          "type": "object",
          "properties": {
            "download": {
              "type": "number"
            },
            "upload": {
              "type": "number"
            }
          }
        },
        "coverage": {
          "type": "object",
          "properties": {
            "avg_rssi": {
              "type": "number"
            }
          }
        }
      }
    }
  }
}