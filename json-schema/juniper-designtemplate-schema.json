{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/DesignTemplate",
  "title": "DesignTemplate",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "label": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "rack_based"
      ]
    },
    "spine": {
      "type": "object",
      "properties": {
        "count": {
          "type": "integer"
        },
        "logical_device_id": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    "rack_types": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "rack_type_id": {
            "type": "string",
            "format": "uuid"
          },
          "count": {
            "type": "integer"
          }
        }
      }
    },
    "asn_allocation_policy": {
      "type": "object",
      "properties": {
        "spine_asn_scheme": {
          "type": "string",
          "enum": [
            "distinct",
            "single"
          ]
        }
      }
    },
    "fabric_addressing_policy": {
      "type": "object",
      "properties": {
        "spine_leaf_links": {
          "type": "string",
          "enum": [
            "ipv4",
            "ipv6",
            "ipv4_ipv6"
          ]
        }
      }
    }
  }
}