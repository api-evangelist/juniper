{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/SoftwarePackage",
  "title": "SoftwarePackage",
  "type": "object",
  "properties": {
    "packageId": {
      "type": "integer"
    },
    "fileName": {
      "type": "string"
    },
    "platform": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "size": {
      "type": "integer",
      "description": "Package size in bytes"
    },
    "uploadDate": {
      "type": "string",
      "format": "date-time"
    }
  }
}