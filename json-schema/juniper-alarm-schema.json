{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/Alarm",
  "title": "Alarm",
  "type": "object",
  "properties": {
    "alarm-time": {
      "type": "string",
      "format": "date-time"
    },
    "alarm-class": {
      "type": "string",
      "enum": [
        "Major",
        "Minor"
      ]
    },
    "alarm-description": {
      "type": "string"
    },
    "alarm-type": {
      "type": "string"
    }
  }
}