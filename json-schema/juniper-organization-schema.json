{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/Organization",
  "title": "Organization",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "name": {
      "type": "string"
    },
    "orggroup_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid"
      }
    },
    "session_expiry": {
      "type": "integer",
      "description": "Session expiry in minutes"
    },
    "alarmtemplate_id": {
      "type": "string",
      "format": "uuid"
    },
    "created_time": {
      "type": "number"
    },
    "modified_time": {
      "type": "number"
    }
  }
}