{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/SecurityZone",
  "title": "SecurityZone",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "label": {
      "type": "string"
    },
    "vrf_name": {
      "type": "string"
    },
    "vlan_id": {
      "type": "integer"
    },
    "routing_policy_id": {
      "type": "string",
      "format": "uuid"
    },
    "sz_type": {
      "type": "string",
      "enum": [
        "evpn",
        "vlan"
      ]
    },
    "rt_policy": {
      "type": "object",
      "properties": {
        "import_RTs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "export_RTs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}