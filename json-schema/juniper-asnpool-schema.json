{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/AsnPool",
  "title": "AsnPool",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "label": {
      "type": "string"
    },
    "ranges": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "first": {
            "type": "integer"
          },
          "last": {
            "type": "integer"
          }
        }
      }
    },
    "status": {
      "type": "string"
    },
    "used": {
      "type": "integer"
    },
    "total": {
      "type": "integer"
    }
  }
}