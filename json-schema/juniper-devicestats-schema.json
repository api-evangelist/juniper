{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/DeviceStats",
  "title": "DeviceStats",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "mac": {
      "type": "string"
    },
    "model": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "connected",
        "disconnected",
        "upgrading",
        "restarting"
      ]
    },
    "uptime": {
      "type": "integer",
      "description": "Device uptime in seconds"
    },
    "last_seen": {
      "type": "number"
    },
    "num_clients": {
      "type": "integer"
    },
    "tx_bytes": {
      "type": "integer"
    },
    "rx_bytes": {
      "type": "integer"
    },
    "tx_pkts": {
      "type": "integer"
    },
    "rx_pkts": {
      "type": "integer"
    }
  }
}